# Supabase Configuration (Required for order persistence)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_ORDERS_TABLE=orders

# Service role key untuk Edge Function (supabase/functions/lookup-order, create-invoice, xendit-webhook)
# TIDAK boleh masuk sini atau ke environment variables Vercel manapun. Set lewat:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your-key
# (tanpa prefix VITE_, karena ini secret milik Supabase Edge Function, bukan
# environment variable Vite/Vercel)

# Xendit Configuration (Required for payment processing)
# Xendit Secret Key dan Callback Token TIDAK boleh masuk sini. Set lewat:
#   supabase secrets set XENDIT_SECRET_KEY=your-test-secret-key
#   supabase secrets set XENDIT_CALLBACK_TOKEN=your-verification-token
# (tanpa prefix VITE_, karena ini secret milik Supabase Edge Function)
VITE_XENDIT_SUCCESS_REDIRECT_URL=https://your-domain.com/checkout/success
VITE_XENDIT_FAILURE_REDIRECT_URL=https://your-domain.com/checkout/failed

# Shipping Quote Configuration (Optional - falls back to flat rate if not set)
VITE_SHIPPING_QUOTE_ENDPOINT=https://your-server.com/api/shipping/quote

# WhatsApp Configuration (Optional - for WhatsApp fallback checkout)
VITE_WHATSAPP_NUMBER=6281234567890

# Analytics Configuration (Optional)
VITE_PLAUSIBLE_DOMAIN=your-domain.com
VITE_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
