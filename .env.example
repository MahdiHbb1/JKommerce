# Supabase Configuration (Required for order persistence)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_ORDERS_TABLE=orders
VITE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Midtrans Configuration (Required for payment processing)
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
VITE_MIDTRANS_TOKEN_ENDPOINT=https://your-server.com/api/midtrans/token
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# Shipping Quote Configuration (Optional - falls back to flat rate if not set)
VITE_SHIPPING_QUOTE_ENDPOINT=https://your-server.com/api/shipping/quote

# WhatsApp Configuration (Optional - for WhatsApp fallback checkout)
VITE_WHATSAPP_NUMBER=6281234567890

# Analytics Configuration (Optional)
VITE_PLAUSIBLE_DOMAIN=your-domain.com
VITE_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
